# Supabase (frontend - Vite)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PROJECT_ID=SEU-PROJETO
VITE_SUPABASE_PUBLISHABLE_KEY=sua-anon-key-aqui

# SnapGen: nada de email/senha aqui. O token JWT é gerenciado
# pelo admin em /admin/snapgen (tabela `app_secrets` no Supabase).
# Quando o token expirar, rode `bun run snapgen:extract` e cole de novo.

# Para a ferramenta local de extração (em tools/snapgen-extract/.env):
# CHROME_DEBUG_URL=http://127.0.0.1:9222
# SNAPGEN_URL=https://snapgen.ai/app/video-gen/veo
